# Copy to .env and adjust as needed. Never commit .env.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Authentication (server-side verification). Never commit service
# account JSON. Configure either Application Default Credentials or this
# Render secret containing the complete JSON object.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=

# Geoapify Places API key (https://myprojects.geoapify.com). Server-side only.
GEOAPIFY_API_KEY=your_actual_api_key_here

# Neon PostgreSQL connection string (Neon console -> Connect). Server-side only.
# postgres:// and postgresql:// are both accepted; sslmode=require is added
# automatically for non-local hosts if not present.
DATABASE_URL=postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional AI planner (Google Gemini). Leave empty to keep TripWise fully
# automatic (recommended for deployments). Only used when a request asks for
# planner "ai"; any failure falls back to the automatic planner. Free-tier
# prompts may be used by Google to improve its products and reviewed by humans,
# so only place data is sent (never titles, notes or user identifiers).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
